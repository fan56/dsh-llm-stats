{
  "name": "@aiwayds/dsh-llm-stats",
  "version": "0.2.0",
  "description": "dsh plugin: persistent whole-machine LLM usage ledger with a pure-text /llm-stats command (tokens, cache hit, model/tool time, per-day bars)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "stats",
    "usage",
    "tokens",
    "deepseek-harness",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-llm-stats.git"
  },
  "homepage": "https://github.com/fan56/dsh-llm-stats",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/fold.test.mjs test/aggregate.test.mjs test/render.test.mjs test/store.test.mjs test/plugin.test.mjs test/backfill.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fliu56",
  "publishConfig": {
    "access": "public"
  }
}
